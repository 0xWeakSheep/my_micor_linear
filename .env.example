# Optional. Defaults to .data/micro-linear.db relative to the application directory.
MICRO_LINEAR_DB_PATH=.data/micro-linear.db

# Attachment and backup roots. Keep both on persistent storage.
MICRO_LINEAR_UPLOAD_DIR=.data/uploads
MICRO_LINEAR_BACKUP_DIR=.data/backups

# Public origin used for same-origin validation in production.
APP_URL=http://localhost:3000

# Development only. When set to 1 under `next dev`, an empty database may be
# populated with the public demo fixture. It is always ignored in production.
MICRO_LINEAR_DEMO_MODE=0

# By default only an empty installation can create its first workspace through
# /signup; all later users must accept an invitation. Set to 1 only if you
# intentionally operate a public multi-workspace service.
MICRO_LINEAR_ALLOW_PUBLIC_SIGNUP=0

# Set long independent random values in production. Changing either value
# invalidates the corresponding stored hashes/sessions.
AUTH_PASSWORD_PEPPER=
AUTH_TOKEN_PEPPER=

# Encrypts outbound webhook signing secrets at rest. Use a separate random
# value in production and keep it stable across deploys/restores.
MICRO_LINEAR_WEBHOOK_ENCRYPTION_KEY=

# Development only: allow webhook delivery to http://localhost/private IPs.
MICRO_LINEAR_WEBHOOK_ALLOW_INSECURE_LOCALHOST=0
