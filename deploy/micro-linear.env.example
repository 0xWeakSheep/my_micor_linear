# Example: https://micro-linear.your-company.com
APP_URL=
# Generate three different values with: openssl rand -base64 48
# The container intentionally refuses to start while any value is empty.
AUTH_PASSWORD_PEPPER=
AUTH_TOKEN_PEPPER=
MICRO_LINEAR_WEBHOOK_ENCRYPTION_KEY=
MICRO_LINEAR_DEMO_MODE=0
MICRO_LINEAR_ALLOW_PUBLIC_SIGNUP=0
MICRO_LINEAR_WEBHOOK_ALLOW_INSECURE_LOCALHOST=0

# Built-in scheduler; disable only when an external scheduler runs jobs:run.
MICRO_LINEAR_BACKGROUND_JOBS_INTERVAL_MS=5000
MICRO_LINEAR_BACKGROUND_JOBS_DISABLED=0
